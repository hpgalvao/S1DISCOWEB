# Apague esta pasta depois de instalar.
# Enquanto ela existir, ninguem consegue abrir os testes pelo navegador;
# rode-os apenas pela linha de comando:  php S1DISCO/testes/teste_completo.php

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
